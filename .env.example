# Copy to .env and fill in. Same conventions as f1-editorial-os.

# "ollama" (local, free) or "anthropic" (API, paid). If unset, falls back to
# anthropic when ANTHROPIC_API_KEY is set, else ollama when OLLAMA_BASE_URL
# or OLLAMA_MODEL is set, else disabled.
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
